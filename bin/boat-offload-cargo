#!/usr/bin/env node
// boat-offload-cargo: a `cargo` wrapper for offload opt-in runs.
// Install as `cargo` ahead of the real executable (BOAT_OFFLOAD=1 opts in),
// or invoke directly: boat-offload-cargo [--dry-run] [--json] -- <cargo argv...>.
// Needs the built plugin: run `npm run build` first so ../dist exists.
import { createShimDeps } from "../dist/offload/shim-node.js";
import { shimMain } from "../dist/offload/shim-main.js";

try {
  const exit = await shimMain(
    process.argv[1] ?? "boat-offload-cargo",
    process.argv.slice(2),
    createShimDeps(process.env),
  );
  process.exit(exit);
} catch (error) {
  process.stderr.write(`boat-offload-cargo: ${error instanceof Error ? error.message : String(error)}\n`);
  process.exit(1);
}
